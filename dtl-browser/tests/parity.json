[
  {
    "name": "text",
    "source": "  hello\n世界  ",
    "context": {},
    "expected": "  hello\n世界  "
  },
  {
    "name": "escaping",
    "source": "{{ name }}",
    "context": {
      "name": "<&>\"'"
    },
    "expected": "&lt;&amp;&gt;&quot;&#x27;"
  },
  {
    "name": "lookup",
    "source": "{{ user.profile.name }}:{{ items.1 }}:{{ missing }}",
    "context": {
      "user": {
        "profile": {
          "name": "Zoë"
        }
      },
      "items": [
        "a",
        "b"
      ]
    },
    "expected": "Zoë:b:"
  },
  {
    "name": "booleans",
    "source": "{{ yes }}/{{ no }}/{{ amount }}",
    "context": {
      "yes": true,
      "no": false,
      "amount": 12
    },
    "expected": "True/False/12"
  },
  {
    "name": "literal_safe",
    "source": "{{ '<b>yes</b>' }}",
    "context": {},
    "expected": "<b>yes</b>"
  },
  {
    "name": "filters",
    "source": "{{ name|upper }}:{{ name|lower }}:{{ name|length }}",
    "context": {
      "name": "Café &"
    },
    "expected": "CAFÉ &amp;:café &amp;:6"
  },
  {
    "name": "defaults",
    "source": "{{ empty|default:'<b>empty</b>' }}:{{ zero|default_if_none:'fallback' }}:{{ nil|default_if_none:name }}",
    "context": {
      "empty": "",
      "zero": 0,
      "nil": null,
      "name": "<&"
    },
    "expected": "<b>empty</b>:0:&lt;&amp;"
  },
  {
    "name": "escape_safe",
    "source": "{{ name|escape|escape }}:{{ name|safe }}",
    "context": {
      "name": "<b>&</b>"
    },
    "expected": "&lt;b&gt;&amp;&lt;/b&gt;:<b>&</b>"
  },
  {
    "name": "join",
    "source": "{{ items|join:', ' }}",
    "context": {
      "items": [
        "a&b",
        "<c>"
      ]
    },
    "expected": "a&amp;b, &lt;c&gt;"
  },
  {
    "name": "quoted_argument",
    "source": "{{ missing|default:'a | b:c' }}",
    "context": {},
    "expected": "a | b:c"
  },
  {
    "name": "if",
    "source": "{% if count > 2 and enabled %}yes{% elif name == 'Zoë' %}maybe{% else %}no{% endif %}",
    "context": {
      "count": 1,
      "enabled": true,
      "name": "Zoë"
    },
    "expected": "maybe"
  },
  {
    "name": "precedence",
    "source": "{% if True or False and False %}yes{% endif %}:{% if not False and 2 >= 1 %}yes{% endif %}",
    "context": {},
    "expected": "yes:yes"
  },
  {
    "name": "membership",
    "source": "{% if name in items %}yes{% endif %}:{% if 'absent' not in mapping %}yes{% endif %}",
    "context": {
      "name": "a",
      "items": [
        "a",
        "b"
      ],
      "mapping": {
        "a": 1
      }
    },
    "expected": "yes:yes"
  },
  {
    "name": "literal_filter_if",
    "source": "{% if 'abc'|length == 3 %}yes{% endif %}",
    "context": {},
    "expected": "yes"
  },
  {
    "name": "loop",
    "source": "{% for row in rows %}{{ forloop.counter }}:{{ row.name }}:{{ forloop.first }}:{{ forloop.last }};{% empty %}empty{% endfor %}",
    "context": {
      "rows": [
        {
          "name": "a&b"
        },
        {
          "name": "c"
        }
      ]
    },
    "expected": "1:a&amp;b:True:False;2:c:False:True;"
  },
  {
    "name": "reversed",
    "source": "{% for item in items reversed %}{{ forloop.revcounter }}={{ item }};{% endfor %}",
    "context": {
      "items": [
        1,
        2
      ]
    },
    "expected": "2=2;1=1;"
  },
  {
    "name": "empty",
    "source": "{% for item in items %}{{ item }}{% empty %}empty{% endfor %}",
    "context": {
      "items": []
    },
    "expected": "empty"
  },
  {
    "name": "nested_loop",
    "source": "{% for outer in items %}{% for inner in items %}{{ forloop.parentloop.counter }}.{{ forloop.counter }};{% endfor %}{% endfor %}",
    "context": {
      "items": [
        1,
        2
      ]
    },
    "expected": "1.1;1.2;2.1;2.2;"
  },
  {
    "name": "scope",
    "source": "{% for name in items %}{{ name }}{% endfor %}:{{ name }}",
    "context": {
      "items": [
        "a",
        "b"
      ],
      "name": "parent"
    },
    "expected": "ab:parent"
  },
  {
    "name": "string_loop",
    "source": "{% for letter in 'é🌍' %}{{ letter }};{% endfor %}",
    "context": {},
    "expected": "é;🌍;"
  },
  {
    "name": "include",
    "source": "{% for row in rows %}{% include template %}{% endfor %}",
    "templates": {
      "card": "<b>{{ row.name }}</b>"
    },
    "context": {
      "template": "card",
      "rows": [
        {
          "name": "<&"
        }
      ]
    },
    "expected": "<b>&lt;&amp;</b>"
  },
  {
    "name": "comments",
    "source": "a{# ignored {{ name }} #}b",
    "context": {},
    "expected": "ab"
  },
  {
    "name": "null_and_missing",
    "source": "{{ nil }}:{{ missing }}:{{ missing|upper }}",
    "context": {
      "nil": null
    },
    "expected": "None::"
  },
  {
    "name": "object_order",
    "source": "{% for key in data %}{{ key }};{% endfor %}",
    "context": {
      "data": {
        "z": 1,
        "a": 2
      }
    },
    "expected": "z;a;"
  },
  {
    "name": "inheritance",
    "source": "{% extends 'base' %}{% block title %}{{ title }}{% endblock %}{% block content %}{% for row in rows %}{% include 'card' %}{% endfor %}{% endblock %}",
    "templates": {
      "base": "<title>{% block title %}Default{% endblock %}</title><main>{% block content %}base{% endblock %}</main>",
      "card": "<b>{{ row.name }}</b>"
    },
    "context": {
      "title": "Café & books",
      "rows": [
        {
          "name": "<one>"
        }
      ]
    },
    "expected": "<title>Café &amp; books</title><main><b>&lt;one&gt;</b></main>"
  },
  {
    "name": "super_safe",
    "source": "{% extends 'base' %}{% block body %}{{ block.super }}<i>{{ name }}</i>{% endblock body %}",
    "templates": {
      "base": "{% block body %}<b>{{ name }}</b>{% endblock %}"
    },
    "context": {
      "name": "<&"
    },
    "expected": "<b>&lt;&amp;</b><i>&lt;&amp;</i>"
  },
  {
    "name": "three_levels",
    "source": "{% extends 'middle' %}{% block body %}C({{ block.super }}){% endblock %}",
    "templates": {
      "base": "{% block body %}A{% endblock %}",
      "middle": "{% extends 'base' %}{% block body %}B({{ block.super }}){% endblock %}"
    },
    "context": {},
    "expected": "C(B(A))"
  },
  {
    "name": "dynamic_parent",
    "source": "{% extends parent|lower %}{% block body %}child{% endblock %}",
    "templates": {
      "base": "[{% block body %}base{% endblock %}]"
    },
    "context": {
      "parent": "BASE"
    },
    "expected": "[child]"
  },
  {
    "name": "nested_blocks",
    "source": "{% extends 'base' %}{% block inner %}child{% endblock %}",
    "templates": {
      "base": "{% block outer %}outer({% block inner %}base{% endblock %}){% endblock %}"
    },
    "context": {},
    "expected": "outer(child)"
  },
  {
    "name": "nested_super",
    "source": "{% extends 'base' %}{% block outer %}child({{ block.super }}){% endblock %}{% block inner %}inner{% endblock %}",
    "templates": {
      "base": "{% block outer %}outer({% block inner %}base{% endblock %}){% endblock %}"
    },
    "context": {},
    "expected": "child(outer(inner))"
  },
  {
    "name": "include_isolation",
    "source": "{% extends 'base' %}{% block body %}{% include 'other' %}{% endblock %}",
    "templates": {
      "base": "{% block body %}base{% endblock %}",
      "other": "{% block body %}other{% endblock %}"
    },
    "context": {},
    "expected": "other"
  },
  {
    "name": "include_inheritance",
    "source": "{% include 'child' %}",
    "templates": {
      "base": "[{% block body %}base{% endblock %}]",
      "child": "{% extends 'base' %}{% block body %}child{% endblock %}"
    },
    "context": {},
    "expected": "[child]"
  },
  {
    "name": "pages/detail.html",
    "source": "{% extends '../base.html' %}{% block body %}{% include './card.html' %}{% endblock %}",
    "templates": {
      "base.html": "[{% block body %}base{% endblock %}]",
      "pages/card.html": "{{ name }}"
    },
    "context": {
      "name": "<&"
    },
    "expected": "[&lt;&amp;]"
  },
  {
    "name": "prefix",
    "source": "prefix{% extends 'base' %}ignored{% block body %}child{% endblock %}",
    "templates": {
      "base": "[{% block body %}base{% endblock %}]"
    },
    "context": {},
    "expected": "prefix[child]"
  },
  {
    "name": "lazy_super",
    "source": "{% extends 'base' %}{% block body %}{% if False %}{{ block.super }}{% endif %}child{% endblock %}",
    "templates": {
      "base": "{% block body %}{{ array }}{% endblock %}"
    },
    "context": {
      "array": [
        1
      ]
    },
    "expected": "child"
  },
  {
    "name": "live_super",
    "source": "{% extends 'base' %}{% block body %}{% for item in items %}{{ block.super }};{% endfor %}{% endblock %}",
    "templates": {
      "base": "{% block body %}{{ item }}{% endblock %}"
    },
    "context": {
      "items": [
        "a",
        "b"
      ]
    },
    "expected": "a;b;"
  },
  {
    "name": "super_empty",
    "source": "{% extends 'base' %}{% block body %}before{{ block.super }}after{% endblock %}",
    "context": {},
    "expected": "beforeafter",
    "templates": {
      "base": "{% block body %}{% endblock %}"
    }
  },
  {
    "name": "block_name",
    "source": "{% block body %}{{ block.name }}{% endblock %}",
    "context": {},
    "expected": "body"
  }
]
